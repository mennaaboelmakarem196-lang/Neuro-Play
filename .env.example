# ==============================================================================
# NeuroPlay AI - Environment Variables Template (.env.example)
# Copy this file to .env and replace placeholders with your actual values.
# DO NOT commit real secrets or production credentials to GitHub!
# ==============================================================================

# Server Runtime Configuration
NODE_ENV=development
PORT=3000

# Authentication Secret (Used for JWT cookie session signing)
# Replace with a strong random secret in production (e.g. 32+ random characters)
JWT_SECRET=your-random-jwt-secret-key-replace-in-production

# Database Connection (MySQL / TiDB Cloud / Aiven)
# Format: mysql://<username>:<password>@<host>:<port>/<database>?ssl={"rejectUnauthorized":true}
DATABASE_URL=mysql://username:password@gateway01.eu-central-1.prod.aws.tidbcloud.com:4000/neuroplay?ssl={"rejectUnauthorized":true}

# Optional: Google Workspace Integration (Sheets & Calendar sync)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_SHEETS_ID=
# GOOGLE_CALENDAR_ID=primary

# Optional: Built-in Forge / LLM API configurations
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
